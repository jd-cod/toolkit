# ══════════════════════════════════════════════════════════
# SysAdmin Toolkit — DEVELOPMENT Environment (.env)
# ══════════════════════════════════════════════════════════
#
# Copy this file to backend/.env and fill in real values:
#   cp backend/sample_development.env backend/.env
#
# This file is NOT committed to git. Keep it secret.
#
# IMPORTANT: Values here must NOT match production.
# Use different DB names, passwords, and JWT secrets.
#
# ══════════════════════════════════════════════════════════

# ── MySQL Database Settings ──────────────────────────────
# DB_HOST and DB_PORT are overridden by docker-compose.dev.yml
# (DB_HOST=mysql, DB_PORT=3306 inside the Docker network)
# NOTE: DB_NAME and MYSQL_DATABASE must be "sysadmin_toolkit" (not "_dev")
# because the migration SQL files hardcode "USE sysadmin_toolkit".
# DB isolation is achieved via separate Docker containers and volumes,
# not different database names.
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_PORT=3307
DB_USER=sysadmin_dev
DB_PASSWORD=<generate-different-password-from-prod>
DB_NAME=sysadmin_toolkit
MYSQL_ROOT_PASSWORD=<generate-different-root-password-from-prod>
MYSQL_DATABASE=sysadmin_toolkit
MYSQL_USER=sysadmin_dev
MYSQL_PASSWORD=<generate-different-password-from-prod>

# ── Authentication & Security ───────────────────────────
# MUST be different from production JWT secret
ADMIN_JWT_SECRET=<generate-different-random-32-char-string>
ADMIN_BOOTSTRAP_USERNAME=<your-admin-username>
ADMIN_BOOTSTRAP_PASSWORD=<your-dev-admin-password>

# ── External API Keys (Optional) ─────────────────────────
# Can use same keys as production (rate limits will be shared)
# Or use separate keys if available
ABUSEIPDB_API_KEY=<your-abuseipdb-api-key>
MAXMIND_LICENSE_KEY=<your-maxmind-license-key>
IP2LOCATION_DOWNLOAD_TOKEN=<your-ip2location-token>
IP2LOCATION_ENABLED=false

# ── Cloudflare R2 Storage ────────────────────────────────
# Required for log storage (nginx ingest & shares)
# Obtain from: Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=systoolkit-logs

# Note: GITHUB_TOKEN is no longer needed (migrated from Gist to R2)

# ── Runtime Configuration ────────────────────────────────
PORT=4000
NODE_ENV=production
