# ══════════════════════════════════════════════════════════
# SysAdmin Toolkit — PRODUCTION Environment (.env)
# ══════════════════════════════════════════════════════════
#
# Copy this file to backend/.env and fill in real values:
#   cp backend/sample_production.env backend/.env
#
# This file is NOT committed to git. Keep it secret.
#
# ══════════════════════════════════════════════════════════

# ── MySQL Database Settings ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_PORT=3306
DB_USER=sysadmin_app
DB_PASSWORD=<generate-strong-password>
DB_NAME=sysadmin_toolkit
MYSQL_ROOT_PASSWORD=<generate-strong-root-password>
MYSQL_DATABASE=sysadmin_toolkit
MYSQL_USER=sysadmin_app
MYSQL_PASSWORD=<generate-strong-password>

# ── Authentication & Security ───────────────────────────
# Generate a random 32+ character string for JWT
ADMIN_JWT_SECRET=<generate-random-32-char-string>
ADMIN_BOOTSTRAP_USERNAME=<your-admin-username>
ADMIN_BOOTSTRAP_PASSWORD=<your-admin-password>

# ── Security Settings ────────────────────────────────────
# Public URL of the site. Used for links in the ingest script and as the
# allowed CORS origin. Strongly recommended in production.
APP_URL=https://<your-domain>
# Origins allowed to call the API cross-origin (comma-separated). Defaults to
# APP_URL. Without either, every origin is allowed.
# CORS_ORIGIN=https://<your-domain>
# Proxies whose X-Forwarded-For entries are trusted when working out the
# client IP for rate limiting. Loopback and private ranges are always trusted.
# Default: cloudflare. Use "none" if the site is not behind Cloudflare, or
# list your proxy IPs/CIDRs (comma-separated).
# Your reverse proxy must forward the visitor's address in X-Forwarded-For,
# otherwise visitors cannot be told apart and the general limit is skipped.
# TRUSTED_PROXIES=cloudflare
# The SSL checker and remote log fetch refuse loopback/private destinations.
# Set to true only on a private network where checking internal hosts is wanted.
# ALLOW_PRIVATE_TARGETS=false

# ── External API Keys (Optional) ─────────────────────────
# AbuseIPDB API key for IP lookup tool
ABUSEIPDB_API_KEY=<your-abuseipdb-api-key>
# MaxMind License Key for GeoIP auto-updates
MAXMIND_LICENSE_KEY=<your-maxmind-license-key>
# IP2Location Token
IP2LOCATION_DOWNLOAD_TOKEN=<your-ip2location-token>
IP2LOCATION_ENABLED=false

# ── Cloudflare R2 Storage (Required) ─────────────────────
# Required for log storage (nginx ingest & shares)
# Obtain from: Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=systoolkit-logs

# Note: GITHUB_TOKEN is no longer needed (migrated from Gist to R2)

# ── Runtime Configuration ────────────────────────────────
PORT=4000
NODE_ENV=production
